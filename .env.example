# Copy to .env and adjust. All values are optional.

# --- Container user --------------------------------------------------------
# The agent runs as appuser with this uid/gid so host bind mounts are
# writable. docker-compose.yml picks up HOST_UID/HOST_GID automatically
# (see the compose file); set them here only to override.
#HOST_UID=1000
#HOST_GID=1000

# --- Workspace -----------------------------------------------------------
# Directory the agent works on (mounted at /workspace inside the container).
# A goosetown working clone is created at <workspace>/goosetown on first
# start; all goosetown env (GOOSETOWN_DIR, GUIDES_DIR, ...) points there.
#WORKSPACE_DIR=/path/to/your/project

# --- Goosetown -------------------------------------------------------------
# Override to use your own goosetown fork, pin a branch/tag, or point at an
# existing clone inside the workspace.
#GOOSETOWN_DIR=/workspace/goosetown
#GOOSETOWN_REPO_URL=https://github.com/aaif-goose/goosetown.git
#GOOSETOWN_REF=main

# --- LLM provider keys (opencode / goose) ---------------------------------
#OPENAI_API_KEY=
#OPENAI_API_BASE=https://api.openai.com/v1
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#MISTRAL_API_KEY=

# --- Shared LLM endpoint (OpenCode + goose, configured once) --------------
# scripts/sync-llm-config.sh writes both agents' configs from these values
# at container start. LLM_ENDPOINT must include the /v1 path.
#LLM_ENDPOINT=http://litellm-proxy:4000/v1
#LLM_API_KEY_ENV=CUSTOM_LITELLM_API_KEY
#LLM_MODELS=mistral-small-latest mistral-large-latest
#LLM_DEFAULT_MODEL=mistral-small-latest
#
# API key - pick ONE of these (env wins if both are set):
#  a) keep the key out of this file entirely: store it in `pass` and use
#     `make up` (it exports the key as the llm_api_key compose secret from
#     PASS_LLM_ENTRY, default "llm/thoth-api-key")
#  b) point LLM_API_KEY_FILE at a file containing the key (compose secret)
#  c) set the key directly here (simplest; key visible in env/docker inspect)
#LLM_API_KEY_FILE=/path/to/keyfile
#CUSTOM_LITELLM_API_KEY=
#LITELLM_MASTER_KEY=

# --- GPG (reuse host keys) ------------------------------------------------
# Two options (see README "Use your GPG keys"):
#  a) mount the host keyring: uncomment the ~/.gnupg volume in
#     docker-compose.yml (stale host daemon state is cleaned at startup)
#  b) import an armored key export: mount the file and set GPG_IMPORT_FILE
#     (generate on the host: gpg --armor --export-secret-keys YOURKEYID)
#GPG_IMPORT_FILE=/home/appuser/gpg-key.asc
# Optionally mark imported keys as ultimately trusted:
#GPG_TRUST_IMPORTED=1

# --- Beads (bd) issue tracker ---------------------------------------------
# Database location override. Default resolution: the project's
# workspace/.beads if present, else /data/beads/.beads (beads-data
# docker volume, auto-created on first start).
#BEADS_DIR=/data/beads/.beads

# --- Goose defaults -------------------------------------------------------
#GOOSE_LLM_PROVIDER=mistral
#GOOSE_LLM_MODEL=mistral-small-latest

# --- Metrics exporter -----------------------------------------------------
#OPENCODE_METRICS_ENABLED=1
#OPENCODE_METRICS_PORT=9464
